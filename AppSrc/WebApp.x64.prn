38448>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38448>>>                Case Break
38449>>>
38449>>>            Case Else // must be nfUndefined
38449>>>
38449>>>        Case End
38449>>>
38449>>>        Send SetActionButtons
