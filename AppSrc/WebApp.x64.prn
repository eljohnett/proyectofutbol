37934>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37937>>>        WebSet pbRender of oNewButton to True
37938>>>        WebSet pbRender of oDetailButton to True
37939>>>
37939>>>        Case Begin
37939>>>            Case (NavigateData.eNavigateType = nfFromParent)
37941>>>                // If from parent, this is a constrained drill down
37941>>>                // If Row select does main-zoom we don't need this
37941>>>                WebSet pbRender of oDetailButton to False
37942>>>                Case Break
37943>>>
37943>>>            Case (NavigateData.eNavigateType = nfFromChild)
37946>>>                // If from child, this is a probably a parent lookup from a Zoom
37946>>>                Case Break
37947>>>
37947>>>            Case (NavigateData.eNavigateType = nfFromMain)
37950>>>                // If from main, this is a probably a main-file lookup from a Zoom
37950>>>                WebSet pbRender of oDetailButton to False
37951>>>                Case Break
37952>>>
37952>>>            Case Else // must be nfUndefined
37952>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37952>>>                // If Row select does main-zoom we don't need this
37952>>>                WebSet pbRender of oDetailButton to False
37953>>>
37953>>>        Case End
37953>>>
37953>>>    End_Procedure
