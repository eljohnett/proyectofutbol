38330>>>    Procedure SetActionButtons
38333>>>        tWebNavigateData NavigateData
38333>>>        tWebNavigateData NavigateData
38333>>>        Boolean bHasRecord
38333>>>        Handle hoDD
38333>>>
38333>>>        Get Server to hoDD
38334>>>        Get GetNavigateData to NavigateData
38335>>>        Get HasRecord of hoDD to bHasRecord
38336>>>
38336>>>        // let's hide all buttons and then Show the ones we want
38336>>>        WebSet pbRender of oEditBtn to False
38337>>>        WebSet pbRender of oSaveBtn to False
38338>>>        WebSet pbRender of oCancelChangesBtn to False
38339>>>        WebSet pbRender of oDeleteBtn to False
38340>>>
38340>>>        If (NavigateData.bReadOnly) Begin
38342>>>            WebSet pbRender of oEditBtn to True
38343>>>        End
38343>>>>
38343>>>        Else Begin
38344>>>            WebSet pbRender of oSaveBtn to True
38345>>>            WebSet pbRender of oCancelChangesBtn to True
38346>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38347>>>        End
38347>>>>
38347>>>    End_Procedure
38348>>>
38348>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38351>>>        // Close after save
38351>>>        Send NavigateClose Self
38352>>>    End_Procedure
38353>>>
38353>>>    // this will close the view after a delete
38353>>>    Procedure OnViewDeleted Handle hoDDO
38356>>>        Send NavigateClose Self
38357>>>    End_Procedure
38358>>>
38358>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38361>>>        Case Begin
38361>>>            Case (NavigateData.eNavigateType = nfFromMain)
38363>>>                // If from main, this is a propbably a main file Select to Zoom.
38363>>>                Case Break
38364>>>
38364>>>            Case (NavigateData.eNavigateType = nfFromParent)
38367>>>                // If from parent, this is a constrained drill down.
38367>>>                Case Break
38368>>>
38368>>>            Case (NavigateData.eNavigateType = nfFromChild)
38371>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38371>>>                Case Break
38372>>>
38372>>>            Case Else // must be nfUndefined
38372>>>
38372>>>        Case End
38372>>>
38372>>>        Send SetActionButtons
38373>>>
38373>>>    End_Procedure
38374>>>
38374>>>End_Object 
