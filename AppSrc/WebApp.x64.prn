38479>>>
38479>>>            Case Else // must be nfUndefined
38479>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38479>>>                // If Row select does main-zoom we don't need this
38479>>>                WebSet pbRender of oDetailButton to False
38480>>>
38480>>>        Case End
