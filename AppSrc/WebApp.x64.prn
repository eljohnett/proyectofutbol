37735>>>    Procedure SetActionButtons
37738>>>        tWebNavigateData NavigateData
37738>>>        tWebNavigateData NavigateData
37738>>>        Boolean bHasRecord
37738>>>        Handle hoDD
37738>>>
37738>>>        Get Server to hoDD
37739>>>        Get GetNavigateData to NavigateData
37740>>>        Get HasRecord of hoDD to bHasRecord
37741>>>
37741>>>        // let's hide all buttons and then Show the ones we want
37741>>>        WebSet pbRender of oEditBtn to False
37742>>>        WebSet pbRender of oSaveBtn to False
37743>>>        WebSet pbRender of oCancelChangesBtn to False
37744>>>        WebSet pbRender of oDeleteBtn to False
37745>>>        WebSet pbRender of obuttonDespedir to False
37746>>>
37746>>>        If (NavigateData.bReadOnly) Begin
37748>>>            WebSet pbRender of oEditBtn to True
37749>>>        End
37749>>>>
37749>>>        Else Begin
37750>>>            WebSet pbRender of oSaveBtn to True
37751>>>            WebSet pbRender of oCancelChangesBtn to True
37752>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37753>>>            WebSet pbRender of obuttonDespedir to True
37754>>>        End
37754>>>>
37754>>>    End_Procedure
37755>>>
37755>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37758>>>        // Close after save
37758>>>        Send NavigateClose Self
37759>>>    End_Procedure
37760>>>
37760>>>    // this will close the view after a delete
37760>>>    Procedure OnViewDeleted Handle hoDDO
37763>>>        Send NavigateClose Self
37764>>>    End_Procedure
37765>>>
37765>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37768>>>        Case Begin
37768>>>            Case (NavigateData.eNavigateType = nfFromMain)
37770>>>                // If from main, this is a propbably a main file Select to Zoom.
37770>>>                Send ShowInfoBox "misma tabla"                 
37771>>>                Case Break        
37772>>>            
37772>>>            Case (NavigateData.eNavigateType = nfFromParent)
37775>>>                // If from parent, this is a constrained drill down.
37775>>>                Case Break
37776>>>
37776>>>            Case (NavigateData.eNavigateType = nfFromChild)
37779>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37779>>>                Case Break
37780>>>
37780>>>            Case Else // must be nfUndefined
37780>>>
37780>>>         Case End
37780>>>
37780>>>         Send SetActionButtons
37781>>>
37781>>>     End_Procedure
37782>>>End_Object 
