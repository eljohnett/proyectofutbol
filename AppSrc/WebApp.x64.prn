39001>>>        Get HasRecord of hoDD to bHasRecord
39002>>>
39002>>>        // let's hide all buttons and then Show the ones we want
39002>>>        WebSet pbRender of oEditBtn to False
39003>>>        WebSet pbRender of oSaveBtn to False
39004>>>        WebSet pbRender of oCancelChangesBtn to False
39005>>>        WebSet pbRender of oDeleteBtn to False
39006>>>
39006>>>        If (NavigateData.bReadOnly) Begin
39008>>>            WebSet pbRender of oEditBtn to True
39009>>>        End
39009>>>>
39009>>>        Else Begin
39010>>>            WebSet pbRender of oSaveBtn to True
39011>>>            WebSet pbRender of oCancelChangesBtn to True
39012>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39013>>>        End
39013>>>>
