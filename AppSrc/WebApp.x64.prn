39106>>>                // If from main, this is a propbably a main file Select to Zoom.
39106>>>                Case Break
39107>>>
39107>>>            Case (NavigateData.eNavigateType = nfFromParent)
39110>>>                // If from parent, this is a constrained drill down.
39110>>>                Case Break
39111>>>
39111>>>            Case (NavigateData.eNavigateType = nfFromChild)
39114>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39114>>>                Case Break
39115>>>
39115>>>            Case Else // must be nfUndefined
39115>>>
39115>>>        Case End
39115>>>
39115>>>        Send SetActionButtons
39116>>>
