38413>>>
38413>>>        // let's hide all buttons and then Show the ones we want
38413>>>        WebSet pbRender of oEditBtn to False
38414>>>        WebSet pbRender of oSaveBtn to False
38415>>>        WebSet pbRender of oCancelChangesBtn to False
38416>>>        WebSet pbRender of oDeleteBtn to False
38417>>>
38417>>>        If (NavigateData.bReadOnly) Begin
38419>>>            WebSet pbRender of oEditBtn to True
38420>>>        End
38420>>>>
38420>>>        Else Begin
38421>>>            WebSet pbRender of oSaveBtn to True
38422>>>            WebSet pbRender of oCancelChangesBtn to True
38423>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38424>>>        End
38424>>>>
38424>>>    End_Procedure
