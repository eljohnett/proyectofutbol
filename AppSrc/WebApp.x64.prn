39073>>>    Procedure SetActionButtons
39076>>>        tWebNavigateData NavigateData
39076>>>        tWebNavigateData NavigateData
39076>>>        Boolean bHasRecord
39076>>>        Handle hoDD
39076>>>
39076>>>        Get Server to hoDD
39077>>>        Get GetNavigateData to NavigateData
39078>>>        Get HasRecord of hoDD to bHasRecord
39079>>>
39079>>>        // let's hide all buttons and then Show the ones we want
39079>>>        WebSet pbRender of oEditBtn to False
39080>>>        WebSet pbRender of oSaveBtn to False
39081>>>        WebSet pbRender of oCancelChangesBtn to False
39082>>>        WebSet pbRender of oDeleteBtn to False
39083>>>
39083>>>        If (NavigateData.bReadOnly) Begin
39085>>>            WebSet pbRender of oEditBtn to True
39086>>>        End
39086>>>>
39086>>>        Else Begin
39087>>>            WebSet pbRender of oSaveBtn to True
39088>>>            WebSet pbRender of oCancelChangesBtn to True
39089>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39090>>>        End
39090>>>>
39090>>>    End_Procedure
